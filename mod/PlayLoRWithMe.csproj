<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import
    Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
    Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')"
  />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{75466C30-4F8C-4E93-B582-594B5C22671F}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>PlayLoRWithMe</RootNamespace>
    <AssemblyName>PlayLoRWithMe</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Locate the game's Managed/ DLL directory.

    Resolution order:
      1. The LOR_MANAGED_DIR environment variable, if set. Use this on machines
         where Steam isn't installed in the default Program Files (x86) path
         (e.g. a different drive, a Linux Proton install, or CI).
      2. The default Steam install path, mirroring what the Steam client
         creates on a stock Windows install.

    Override locally with:
      set LOR_MANAGED_DIR=D:\Games\Library Of Ruina\LibraryOfRuina_Data\Managed

    Both ItemGroup HintPaths below and the AfterBuild Copy step read $(LorManagedDir).
  -->
  <PropertyGroup>
    <LorManagedDir Condition=" '$(LOR_MANAGED_DIR)' != '' ">$(LOR_MANAGED_DIR)</LorManagedDir>
    <LorManagedDir Condition=" '$(LorManagedDir)' == '' ">..\..\..\..\..\Program Files (x86)\Steam\steamapps\common\Library Of Ruina\LibraryOfRuina_Data\Managed</LorManagedDir>
  </PropertyGroup>

  <!--
    Locate the Steam workshop directory containing optional, soft-dependency
    mods (CustomSpeedDiceColor, CustomRarityUtil, etc.). Resolution mirrors
    LorManagedDir: env var first, then a default for the stock Steam path.

    Optional-mod DLLs are referenced via HintPath with Private=False — we
    compile against them for type-safe API calls, but we don't bundle them
    in our build output (those mods are independent subscriptions). The
    runtime soft-dep guarantee is preserved via assembly-presence checks
    in each probe (see CustomDiceColorProbe.HasCdc et al.); the CLR loads
    optional-mod types lazily, so the gated entry points keep the mod
    loadable when those subscriptions are absent.
  -->
  <PropertyGroup>
    <LorWorkshopDir Condition=" '$(LOR_WORKSHOP_DIR)' != '' ">$(LOR_WORKSHOP_DIR)</LorWorkshopDir>
    <LorWorkshopDir Condition=" '$(LorWorkshopDir)' == '' ">..\..\..\..\..\Program Files (x86)\Steam\steamapps\workshop\content\1256670</LorWorkshopDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>packages\Lib.Harmony.2.3.3\lib\net48\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(LorManagedDir)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(LorManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(LorManagedDir)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(LorManagedDir)\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(LorManagedDir)\UnityEngine.UI.dll</HintPath>
    </Reference>
    <!--
      Optional soft-dependency: CustomRarityUtil (workshop id 2874916185).
      Compiled against for type-safe API access to CardRarityXmlList; Private=False
      so the optional DLL is never bundled into our build output. Runtime
      soft-dep is enforced via CustomRarityProbe.HasCru — when the assembly
      is absent the JIT never resolves CustomRarityUtil types and the mod
      stays loadable.
    -->
    <Reference Include="CustomRarityUtil">
      <HintPath>$(LorWorkshopDir)\2874916185\Assemblies\CustomRarityUtil.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <!--
    Glob every .cs file under the project instead of listing them one by one.
    The old explicit item list silently dropped any new file that wasn't
    added to it: no build warning, no error, the file just never compiles.
    That already cost a debugging session once (StoryLog.cs had to be added
    here by hand, and it was easy to miss).

    Excludes:
      - bin/, obj/  build output; obj\ also holds MSBuild-generated files
        (e.g. AssemblyAttributes.cs) that must not be compiled twice.
      - mod.tests\  a separate SDK-style test project (mod.tests.csproj)
        that links a subset of these same files in directly (see its
        Compile items with Link=). Excluding it here stops this project
        from also swallowing them into a second assembly.
  -->
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**\*.cs;obj\**\*.cs;mod.tests\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="packages.config" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!--
    AfterBuild: build the Vue frontend, then assemble a deployable mod folder
    inside $(OutputPath). Result layout mirrors what LoR expects:
      bin\Debug\PlayLoRWithMe\
        StageModInfo.xml
        Data\...
        Resource\...
        wwwroot\...     <- copied directly from frontend\.output\public\
        Assemblies\
          PlayLoRWithMe.dll
          PlayLoRWithMe.pdb   (Debug only)
  -->
  <PropertyGroup>
    <FrontendDir>$(MSBuildProjectDirectory)\..\frontend</FrontendDir>
  </PropertyGroup>

  <!--
    NpmInstall: skipped on incremental builds when node_modules is already in
    sync with package-lock.json. The Inputs/Outputs gate uses MSBuild's
    timestamp comparison: if `node_modules\.package-lock.json` (the marker npm
    writes after a successful install) is newer than `package-lock.json`, the
    target is up-to-date and `npm install` doesn't run. The install command
    uses prefer-offline (reuse local cache) and no-audit / no-fund (strip
    output we don't act on); see the Exec Command attribute below for the
    flags.
  -->
  <Target
    Name="NpmInstall"
    Inputs="$(FrontendDir)\package.json;$(FrontendDir)\package-lock.json"
    Outputs="$(FrontendDir)\node_modules\.package-lock.json"
    Condition="Exists('$(FrontendDir)\package.json')"
  >
    <Exec
      Command="npm install --prefer-offline --no-audit --no-fund"
      WorkingDirectory="$(FrontendDir)"
    />
  </Target>

  <Target Name="AfterBuild" DependsOnTargets="NpmInstall">
    <!-- Build the Vue frontend if it has been scaffolded. `npm run generate`
         always runs because Nuxt's incremental build is faster than tracking
         every frontend source file from MSBuild. -->
    <Exec
      Command="npm run generate --logLevel=silent"
      WorkingDirectory="$(FrontendDir)"
      Condition="Exists('$(FrontendDir)\package.json')"
    />

    <!--
      Clear the staged mod folder before re-populating it. Every Copy below
      only ever adds or overwrites, so a file that disappears from the sources
      lingers in the output forever. Nuxt makes that routine rather than rare:
      it emits content-hashed filenames under wwwroot\_nuxt\, so each rebuild
      writes new names beside the old ones instead of replacing them. Deleted
      assets behave the same way — retiring a self-hosted font left its woff2
      staged here indefinitely.

      Stale files are inert (nothing references them) but they are shipped:
      build_and_run.sh copies this whole folder into the game's Mods\ dir, so
      whatever accumulates here reaches the install and makes the deployed
      output misleading to inspect.

      Everything under PlayLoRWithMe\ is reproduced by the copies that follow
      (ModData, the frontend dist, and Assemblies), and nothing writes here at
      runtime — the game runs from the deployed copy, not from bin — so a full
      clean is safe. It does mean SkipUnchangedFiles no longer spares any I/O,
      which costs roughly two megabytes of copying per build; correctness of
      the staged output is worth more than that.
    -->
    <RemoveDir Directories="$(OutputPath)PlayLoRWithMe" />

    <!-- Copy ModData contents (everything except wwwroot) into the output root.
         %(RecursiveDir) is relative to the ModData\ wildcard base, so the
         ModData\ prefix is automatically stripped. -->
    <ItemGroup>
      <ModDataFiles Include="ModData\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(ModDataFiles)"
      DestinationFiles="@(ModDataFiles->'$(OutputPath)PlayLoRWithMe\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
    />

    <!-- Copy the Vite build output directly into wwwroot\ in the output.
         %(RecursiveDir) is relative to the frontend\.output\public\ wildcard base. -->
    <ItemGroup>
      <FrontendDistFiles
        Include="$(FrontendDir)\.output\public\**\*"
        Condition="Exists('$(FrontendDir)\.output\public')"
      />
    </ItemGroup>
    <Copy
      SourceFiles="@(FrontendDistFiles)"
      DestinationFiles="@(FrontendDistFiles->'$(OutputPath)PlayLoRWithMe\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
    />

    <!-- Place the compiled DLL (and PDB if present) in Assemblies\ -->
    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(OutputPath)PlayLoRWithMe\Assemblies\"
    />
    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).pdb"
      DestinationFolder="$(OutputPath)PlayLoRWithMe\Assemblies\"
      Condition="Exists('$(OutputPath)$(AssemblyName).pdb')"
    />

    <!-- Copy third-party dependencies into Assemblies\ -->
    <Copy
      SourceFiles="packages\Lib.Harmony.2.3.3\lib\net48\0Harmony.dll"
      DestinationFolder="$(OutputPath)PlayLoRWithMe\Assemblies\"
      SkipUnchangedFiles="true"
    />
  </Target>
</Project>
